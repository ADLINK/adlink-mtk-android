From 4831fcb7d11eaaea3cf8293ac0902e8f2f491f6b Mon Sep 17 00:00:00 2001
From: Santhana Kumar A <santhanakumar@adlinktech.com>
Date: Thu, 5 Nov 2026 16:40:21 +0530
Subject: [PATCH] osm-mtk520: add WLAN firmware and disable LVDS in lk2

Signed-off-by: Santhana Kumar A <santhanakumar@adlinktech.com>

diff --git a/proprietary/bootable/bootloader/lk2/platform/mediatek/mt8189/disp/mt_disp_drv.c b/proprietary/bootable/bootloader/lk2/platform/mediatek/mt8189/disp/mt_disp_drv.c
index b004b8a..c9c2956 100644
--- a/proprietary/bootable/bootloader/lk2/platform/mediatek/mt8189/disp/mt_disp_drv.c
+++ b/proprietary/bootable/bootloader/lk2/platform/mediatek/mt8189/disp/mt_disp_drv.c
@@ -270,14 +270,13 @@ static void mt_disp_init(void *lcd_pa_base, void *lcd_va_base, void *fdt)
 
     fb_offset_logo = 0;
 
-
     if (DISP_SCENARIO_IS_EDP(g_disp_main_scn) ||
         DISP_SCENARIO_IS_LVDS(g_disp_main_scn) ||
         DISP_SCENARIO_IS_DP(g_disp_main_scn) ||
         DISP_SCENARIO_IS_HDMI(g_disp_main_scn)) {
         mt_maindisp_init(lcd_pa_base);
         memset(lcd_va_base, 0x0, ALIGN_TO(mt_maindisp_get_vram_size(), 0x10000));
-        DISPMSG("%s done with mt_maindisp_init flow for EDPTX/DPTX/HDMI_MAIN!\n", __func__);
+        DISPMSG("%s done with mt_maindisp_init flow for EDPTX/DPTX/HDMI_MAIN/LVDS!\n", __func__);
         display_info.islcmfound = 1 | ((DISP_enable_num() & 0xFFFF) << 16);
         if (DISP_SCENARIO_IS_EDP(g_disp_main_scn))
             display_info.lcm_id =  EDP_OUT;
@@ -590,20 +589,22 @@ void disp_init(void *fdt)
     /* parse lk display scenario drom dtb */
     lk_display_get_scenario_from_dtb(fdt);
 
-    if (DISP_SCENARIO_IS_EDP(g_disp_main_scn)) {
-        mtk_edp_init(fdt, false, false);
-        mt_maindisp_get_w_h(&disp_width, &disp_height);
+    if (DISP_SCENARIO_IS_LVDS(g_disp_main_scn)) {
+        disp_width = 1280;
+        disp_height = 800;
+        mt_maindisp_set_w_h(disp_width, disp_height);
         primary_display_set_width(disp_width);
         primary_display_set_height(disp_height);
-        dprintf(CRITICAL, "(EDP) maindisp_width = %d maindisp_height = %d\n",
+        dprintf(CRITICAL, "(LVDS) maindisp_width = %d maindisp_height = %d\n",
                                                         disp_width, disp_height);
     }
-    if (DISP_SCENARIO_IS_LVDS(g_disp_main_scn)) {
-        lvds_init(fdt);
+
+    if (DISP_SCENARIO_IS_EDP(g_disp_main_scn)) {
+        mtk_edp_init(fdt, false, false);
         mt_maindisp_get_w_h(&disp_width, &disp_height);
         primary_display_set_width(disp_width);
         primary_display_set_height(disp_height);
-        dprintf(CRITICAL, "maindisp_width = %d maindisp_height = %d\n",
+        dprintf(CRITICAL, "(EDP) maindisp_width = %d maindisp_height = %d\n",
                                                         disp_width, disp_height);
     }
 
@@ -723,7 +724,8 @@ static void mt_disp_sw_init(void *lcd_pa_base, void *lcd_va_base, void *fdt)
 
     if (display_info.lcm_id == EDP_OUT ||
         display_info.lcm_id == DP_OUT ||
-        display_info.lcm_id == LVDS_OUT) {
+        display_info.lcm_id == LVDS_OUT ||
+        DISP_SCENARIO_IS_LVDS(g_disp_main_scn)) {
         mt_maindisp_init(lcd_pa_base);
         return;
     }
@@ -767,12 +769,14 @@ void disp_sw_init(void *fdt)
         primary_display_set_height(disp_height);
         dprintf(CRITICAL, "(DP) maindisp_width = %d maindisp_height = %d\n",
                                                         disp_width, disp_height);
-    } else if (display_info.lcm_id == LVDS_OUT) {
-        lvds_init(NULL);
-        mt_maindisp_get_w_h(&disp_width, &disp_height);
+    } else if (display_info.lcm_id == LVDS_OUT || DISP_SCENARIO_IS_LVDS(g_disp_main_scn)) {
+        disp_width = 1280;
+        disp_height = 800;
+        mt_maindisp_set_w_h(disp_width, disp_height);
         primary_display_set_width(disp_width);
         primary_display_set_height(disp_height);
-        dprintf(CRITICAL, "maindisp_width = %d maindisp_height = %d\n", disp_width, disp_height);
+        dprintf(CRITICAL, "(LVDS) maindisp_width = %d maindisp_height = %d\n",
+                                                        disp_width, disp_height);
     } else {
         ret = primary_display_lcm_probe(display_info.lcm_name, display_info.ext_lcm_idx, fdt);
 
@@ -976,6 +980,11 @@ void mt_disp_config_frame_buffer(void *fdt)
     int offset;
     int ret = 0;
 
+    if (!g_fb_init) {
+        DISPMSG("[DISP] skip mt_disp_config_frame_buffer: fb not init\n");
+        return;
+    }
+
     fb_base_h = cpu_to_fdt32(fb_base_h);
     fb_base_l = cpu_to_fdt32(fb_base_l);
     /*g_fb_size = cpu_to_fdt32(g_fb_size);*/
@@ -1084,6 +1093,11 @@ void target_atag_videolfb(void *fdt)
     unsigned long long *phy_p;
     int ret = 0;
 
+    if (!g_fb_init) {
+        DISPMSG("[DISP] skip target_atag_videolfb: fb not init\n");
+        return;
+    }
+
     ptr = malloc(sizeof(char) * 512);
     if (ptr == NULL) {
         DISPERR("%s %u alloc fail\n", __func__, __LINE__);
@@ -1131,6 +1145,11 @@ void disp_lcm_fill_lcm_dts_phandle(void *fdt)
     int dts_is_cphy = primary_display_get_is_cphy();
     unsigned int dsi_idx = 0;
 
+    if (DISP_SCENARIO_IS_LVDS(g_disp_main_scn) || display_info.lcm_id == LVDS_OUT) {
+        DISPMSG("[DISP] skip disp_lcm_fill_lcm_dts_phandle for LVDS boot\n");
+        return;
+    }
+
 #ifdef MTK_LCM_COMMON_DRIVER_SUPPORT
     int phy_type = MTK_LCM_MIPI_DPHY;
 
